$airkit_secret $mol_view
	value \
	stage? \shown
	head_text @ \Copy this secret now. It is shown once.
	note_text @ \It is not stored in a readable form. If it is lost, create a new one.
	copied_text @ \Copied. Store it where it belongs; this page will not show it again.
	gone_text @ \The secret was shown once and is gone. If it was lost, create a new one.
	copy_title @ \Copy
	copied_title @ \Copied
	done_title @ \Done, hide it
	attr *
		^
		airkit_secret_stage <= stage
	sub <= parts /
	Head $mol_view
		sub /
			<= head_text
	Row $mol_view
		sub /
			<= Value $mol_view
				sub /
					<= value
			<= Copy $mol_button_minor
				title <= copy_label \
				click? <=> copy? null
	Note $mol_view
		sub /
			<= note_shown \
	Done $mol_button_minor
		title <= done_title
		click? <=> done? null
	Gone $mol_view
		sub /
			<= gone_text
