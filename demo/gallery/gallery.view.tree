$airkit_demo_gallery $mol_page
	title @ \Components
	tools /
		<= Sample $airkit_pill
			title @ \Sample data
		<= Source $mol_link_source
			uri \https://github.com/alexesDev/airkit/tree/main/demo/gallery
	body /
		<= Pills $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/pill
			title @ \Status pill
			note @ \One of four tones. Colour is state, never decoration.
			content /
				<= Pill_row $mol_view
					sub /
						<= Pill_ok $airkit_pill
							tone \ok
							title @ \running
						<= Pill_warn $airkit_pill
							tone \warn
							title @ \blocked
						<= Pill_bad $airkit_pill
							tone \bad
							title @ \failing
						<= Pill_neutral $airkit_pill
							title @ \paused
		<= Stats $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/stat
			title @ \Stat tile
			note @ \Value, unit, delta with direction, sparkline, limit meter, not measured
			content /
				<= Stat_tiles $airkit_tiles
					sub /
						<= Stat_spark $airkit_stat
							label @ \Requests
							value \1,284
							delta 18
							series <= spark_series /number
						<= Stat_bad $airkit_stat
							label @ \Error rate
							value \0.9
							unit \%
							delta 0.4
							delta_unit \ pt
							higher_is_better false
							note @ \against the 30 days before
						<= Stat_meter $airkit_stat
							label @ \Storage used
							value \63
							unit \%
							note @ \limit warns at 80%
							portion 0.63
							tick 0.8
						<= Stat_none $airkit_stat
							label @ \Queue wait
							measured false
							note @ \no worker reported in 24 h
		<= Meters $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/meter
			title @ \Limit meter
			note @ \A fill and an optional tick at the limit
			content /
				<= Meter_rows $mol_view
					sub /
						<= Meter_low $airkit_meter
							portion 0.4
						<= Meter_warn $airkit_meter
							portion 0.86
							tick 0.8
							tone \warn
						<= Meter_bad $airkit_meter
							portion 1
							tick 0.8
							tone \bad
		<= Kv $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/kv
			title @ \Key–value card
			content /
				<= Kv_card $airkit_kv
					fields *
						Schedule \every 15 minutes
						Timeout \60 s
						Owner \ops@example.com
						Created \2026-09-14 10:22
		<= Attention $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/attention
			title @ \Needs you
			note @ \The number is how many items wait; the empty list says so
			content /
				<= Attention_full $airkit_attention
					entries <= attention_entries /$airkit_attention_entry
				<= Attention_calm $airkit_attention
		<= Feed $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/feed
			title @ \Activity feed
			content /
				<= Feed_list $airkit_feed
					entries <= feed_entries /$airkit_feed_entry
		<= Empty $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/empty
			title @ \Empty state
			content /
				<= Empty_state $airkit_empty
					title @ \No keys yet
					text @ \A key lets a script call the API on your behalf. It is shown once, when it is created.
					action_title @ \Create key
					action_arg *
						section \keys
						key \add
		<= Confirm $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/confirmpage
			title @ \Confirm page
			note @ \A destructive action opens a page of its own: what happens, and one button
			content /
				<= Confirm_link $mol_link
					title @ \Open the revoke page of nightly-ci
					arg *
						section \keys
						key \key2
						key_confirm \revoke
		<= Secret $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/secret
			title @ \Secret, shown once
			note @ \Shown, copied, gone
			content /
				<= Secret_shown $airkit_secret
					value \sk_sample_4f1c0e9a2b7d83e65c19a0f4
				<= Secret_copied $airkit_secret
					value \sk_sample_4f1c0e9a2b7d83e65c19a0f4
					stage \copied
				<= Secret_gone $airkit_secret
					stage \gone
		<= Chips $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/chips
			title @ \Filter chips
			content /
				<= Chips_demo $airkit_chips
					value? <=> chip? \all
					options *
						all @ \All
						failing @ \Failing
						paused @ \Paused
					counts *
						all 5
						failing 1
						paused 1
		<= Chart $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/chart
			title @ \Chart
			note @ \Axes, and a legend that carries the totals
			content /
				<= Chart_demo $airkit_chart
					series <= chart_series /$airkit_chart_series
					labels <= chart_labels /string
		<= Runs $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/runs
			title @ \Last runs
			content /
				<= Runs_rows $mol_view
					sub /
						<= Runs_ok $airkit_runs
							runs /string
								\ok
								\ok
								\ok
								\ok
								\ok
								\ok
								\ok
								\ok
								\ok
								\ok
						<= Runs_bad $airkit_runs
							runs /string
								\ok
								\ok
								\ok
								\ok
								\ok
								\ok
								\bad
								\ok
								\bad
								\bad
						<= Runs_new $airkit_runs
							runs /string
								\ok
								\ok
								\ok
								\none
								\none
								\none
								\none
								\none
								\none
								\none
		<= List $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/columns
			title @ \List with labels once
			note @ \Column titles above the list; each row is a row of labelers
			content /
				<= List_columns $airkit_columns
					titles /
						<= list_columns_text @ \Name
						<= list_columns_text_1 @ \Status
						<= list_columns_text_2 @ \Owner
						<= list_columns_text_3 @ \Last used
				<= List_rows $mol_list
					rows <= list_rows /
		<= Form $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/air
			title @ \Form
			note @ \Focus ring, the error line under its field, buttons
			content /
				<= Form_demo $mol_form
					body /
						<= Name_field $mol_form_field
							name @ \Name
							bid <= name_bid \
							control <= Name_control $mol_string
								hint @ \lowercase-with-dashes
								value? <=> name? \Sales Desk
						<= Note_field $mol_form_field
							name @ \Note
							control <= Note_control $mol_string
								hint @ \May stay empty
								value? <=> note? \
					buttons /
						<= Submit $mol_button_major
							title @ \Create
							click? <=> submit? null
						<= Form_status $mol_status
							message <= form_message? \
		<= Actions $airkit_section
			title @ \Actions
			note @ \At rest, pressed, and waiting (moving stripes); a loading block; a live button that waits 3 s
			source \https://github.com/alexesDev/airkit/tree/main/air
			content /
				<= Actions_rest $mol_view
					sub /
						<= Major_rest $mol_button_major
							title @ \Run now
						<= Minor_rest $mol_button_minor
							title @ \Pause
						<= Danger_rest $mol_button_major
							title @ \Revoke
							attr *
								^
								airkit_tone \bad
				<= Actions_pressed $mol_view
					sub /
						<= Major_pressed $mol_button_major
							title @ \Run now
							attr *
								^
								airkit_pressed \
						<= Minor_pressed $mol_button_minor
							title @ \Pause
							attr *
								^
								airkit_pressed \
						<= Danger_pressed $mol_button_major
							title @ \Revoke
							attr *
								^
								airkit_tone \bad
								airkit_pressed \
				<= Actions_pending $mol_view
					sub /
						<= Major_pending $mol_button_major
							title @ \Run now
							attr *
								^
								airkit_pending \
						<= Minor_pending $mol_button_minor
							title @ \Pause
							attr *
								^
								airkit_pending \
						<= Danger_pending $mol_button_major
							title @ \Revoke
							attr *
								^
								airkit_tone \bad
								airkit_pending \
						<= Block_pending $mol_view
							attr *
								^
								airkit_pending \
						<= Major_live $mol_button_major
							title @ \Try: run for 3 s
							click? <=> try_run? null
		<= Links $airkit_section
			title @ \Links and actions
			note @ \Text links and text-style actions in the link colour, underlined on hover; danger in the bad colour; one filled primary
			source \https://github.com/alexesDev/airkit/tree/main/air
			content /
				<= Links_text $mol_view
					sub /
						<= links_before @ \The key was created by
						<= Links_owner $mol_link
							title @ \admin@example.com
							arg *
								section \keys
						<= links_after @ \and is used by two scripts.
				<= Links_actions $mol_view
					sub /
						<= Links_primary $mol_button_major
							title @ \Save
						<= Links_minor $mol_button_minor
							title @ \Pause
						<= Links_tool $mol_link
							title @ \Settings
							arg *
								section \jobs
						<= Links_danger $mol_link
							title @ \Revoke
							attr *
								^
								airkit_tone \bad
							arg *
								section \keys
								key \key2
								key_confirm \revoke
		<= Disabled $airkit_section
			title @ \Enabled and disabled
			note @ \A disabled action is quieter than an enabled one: no frame, the same hue at lower contrast
			source \https://github.com/alexesDev/airkit/tree/main/air
			content /
				<= Disabled_on $mol_view
					sub /
						<= Enabled_major $mol_button_major
							title @ \Save
						<= Enabled_minor $mol_button_minor
							title @ \Unban
						<= Enabled_danger $mol_button_minor
							title @ \Remove admin
							attr *
								^
								airkit_tone \bad
				<= Disabled_off $mol_view
					sub /
						<= Disabled_major $mol_button_major
							title @ \Save
							enabled false
						<= Disabled_minor $mol_button_minor
							title @ \Unban
							enabled false
						<= Disabled_danger $mol_button_minor
							title @ \Remove admin
							enabled false
							attr *
								^
								airkit_tone \bad
		<= Confirmpages $airkit_section
			title @ \Confirm page, enabled and disabled
			note @ \The red Confirm keeps a readable label at rest and when it cannot be pressed
			source \https://github.com/alexesDev/airkit/tree/main/confirmpage
			content /
				<= Confirmpages_row $mol_view
					sub /
						<= Confirm_on $airkit_confirmpage
							title @ \Revoke nightly-ci?
							text @ \Scripts that use nightly-ci stop working at once.
							confirm_title @ \Revoke
						<= Confirm_off $airkit_confirmpage
							title @ \Revoke nightly-ci?
							text @ \Scripts that use nightly-ci stop working at once.
							confirm_title @ \Revoke
							confirm_enabled false
		<= Stock $airkit_section
			title @ \Stock widgets under the theme
			note @ \A checkbox, a portion bar, and a list of plain rows that are not links
			source \https://github.com/alexesDev/airkit/tree/main/air
			content /
				<= Checks $mol_view
					sub /
						<= Check_off $mol_check_box
							title @ \Send a daily digest
							checked? <=> digest? false
						<= Check_on $mol_check_box
							title @ \Keep a copy of every reply
							checked? <=> copies? true
				<= Portions $mol_view
					sub /
						<= Portion_low $mol_portion
							portion 0.25
						<= Portion_high $mol_portion
							portion 0.8
				<= Plain_rows $mol_list
					rows /
						<= Plain_first $mol_row
							sub /
								<= Plain_first_name $mol_labeler
									title @ \Node
									content /
										<= plain_first_name @ \box-1
								<= Plain_first_used $mol_labeler
									title @ \Used
									content /
										<= plain_first_used @ \38%
						<= Plain_second $mol_row
							sub /
								<= Plain_second_name $mol_labeler
									title @ \Node
									content /
										<= plain_second_name @ \box-2
								<= Plain_second_used $mol_labeler
									title @ \Used
									content /
										<= plain_second_used @ \12%
		<= Switch $airkit_section
			source \https://github.com/alexesDev/airkit/tree/main/air
			title @ \Segmented switch
			note @ \A stock $mol_switch under the theme
			content /
				<= Segmented $mol_switch
					value? <=> segment? \30d
					options *
						24h \24 hours
						7d \7 days
						30d \30 days
	List_row* $mol_view
		minimal_height 40
		sub /
			<= List_cells* $mol_row
				sub /
					<= List_name* $mol_labeler
						title @ \Name
						content /
							<= list_name* \
					<= List_status* $mol_labeler
						title @ \Status
						content /
							<= List_pill* $airkit_pill
								tone <= list_tone* \neutral
								title <= list_status* \
					<= List_owner* $mol_labeler
						title @ \Owner
						content /
							<= list_owner* \
					<= List_used* $airkit_labeler_moment
						title @ \Last used
						value <= list_used* \
