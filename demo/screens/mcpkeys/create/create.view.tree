$airkit_demo_screens_mcpkeys_create $mol_page
	store $airkit_demo_screens_mcpkeys_store
	title @ \New MCP key
	tools <= actions /
		<= Create $mol_button_major
			title @ \Create
			click? <=> create? null
		<= Again $mol_button_minor
			title @ \Create another
			click? <=> again? null
	body <= form_rows /
		<= Name_field $mol_form_field
			name @ \Name
			bid <= name_bid \
			control <= Name $mol_string
				hint @ \What will use this key
				value? <=> name? \
		<= Status $mol_status
			message <= message \
		<= Secret $airkit_secret
			value <= secret \
			head_text @ \Key - shown once, copy it now
			copy_title @ \Copy key
			parts <= secret_parts /
		<= Open $mol_link
			arg <= open_arg *
			title @ \Open the key
